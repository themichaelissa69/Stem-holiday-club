<!DOCTYPE html>
< lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>STEM Holiday Club</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- ADMIN LOGIN -->
<section id="loginScreen" class="login-screen">
    <div class="login-card">
        <div class="login-logo">STEM</div>

        <p class="login-label">STEM HOLIDAY CLUB</p>
        <h1>Admin Login</h1>
        <p>Equipment Registration System</p>

        <form id="loginForm">
            <label for="adminEmail">ADMIN EMAIL</label>
            <input
                type="email"
                id="adminEmail"
                placeholder="Enter admin email"
                required
            >

            <label for="adminPassword">PASSWORD</label>
            <input
                type="password"
                id="adminPassword"
                placeholder="Enter password"
                required
            >

            <button type="submit" id="loginButton">
                LOGIN
            </button>

            <p id="loginMessage"></p>
        </form>
    </div>
</section>

<!-- MAIN APP -->
<div id="mainApp">
<header class="header">

    <div class="brand">
        <div class="logo">STEM</div>

        <div>
            <h1>STEM HOLIDAY CLUB</h1>
            <p>Equipment Registration System</p>
        </div>
    </div>

    <button
        class="menu-button"
        onclick="toggleMenu()"
    >
        ☰
    </button>

</header>


<div class="layout">

    <!-- SIDEBAR -->

    <aside id="sidebar">

        <button
            class="nav-button active"
            onclick="openPage('dashboard', this)"
        >
            🏠 Dashboard
        </button>

        <button
            class="nav-button"
            onclick="openPage('multimedia', this)"
        >
            🎥 Multimedia
        </button>

        <button
            class="nav-button"
            onclick="openPage('robotics', this)"
        >
            🤖 Robotics
        </button>

        <button
            class="nav-button"
            onclick="openPage('entrepreneurship', this)"
        >
            💼 Entrepreneurship
        </button>

        <button
            class="nav-button"
            onclick="openPage('chess', this)"
        >
            ♟ Chess
        </button>

        <button
            class="nav-button"
            onclick="openPage('hackathon', this)"
        >
            💻 Hackathon
        </button>

      <button
    class="nav-button logout-button"
    onclick="logout()"
>
    🚪 Logout
</button>
      
    </aside>


    <!-- MAIN -->

    <main>


        <!-- DASHBOARD -->

        <section
            id="dashboard"
            class="page active"
        >

            <div class="page-header">

                <span>DASHBOARD</span>

                <h2>
                    STEM Holiday Club
                </h2>

                <p>
                    Equipment registration overview
                </p>

            </div>


            <div class="stats">

                <div class="stat">
                    <p>Total Registrations</p>
                    <h3 id="totalRegistrations">
                        0
                    </h3>
                </div>

                <div class="stat">
                    <p>Currently Signed In</p>
                    <h3 id="currentlySignedIn">
                        0
                    </h3>
                </div>

                <div class="stat">
                    <p>Completed</p>
                    <h3 id="completedRegistrations">
                        0
                    </h3>
                </div>

                <div class="stat">
                    <p>Activities</p>
                    <h3>5</h3>
                </div>

            </div>


            <div class="dashboard-box">

                <h3>
                    Activities
                </h3>

                <div
                    id="activitySummary"
                ></div>

            </div>

        </section>



        <!-- MULTIMEDIA -->

        <section
            id="multimedia"
            class="page"
        >

            <div class="page-header">

                <span>ACTIVITY 01</span>

                <h2>MULTIMEDIA</h2>

                <p>
                    Equipment registration
                </p>

            </div>

            <div id="multimediaContent"></div>

        </section>



        <!-- ROBOTICS -->

        <section
            id="robotics"
            class="page"
        >

            <div class="page-header">

                <span>ACTIVITY 02</span>

                <h2>ROBOTICS</h2>

                <p>
                    Equipment registration
                </p>

            </div>

            <div id="roboticsContent"></div>

        </section>



        <!-- ENTREPRENEURSHIP -->

        <section
            id="entrepreneurship"
            class="page"
        >

            <div class="page-header">

                <span>ACTIVITY 03</span>

                <h2>ENTREPRENEURSHIP</h2>

                <p>
                    Equipment registration
                </p>

            </div>

            <div id="entrepreneurshipContent"></div>

        </section>



        <!-- CHESS -->

        <section
            id="chess"
            class="page"
        >

            <div class="page-header">

                <span>ACTIVITY 04</span>

                <h2>CHESS</h2>

                <p>
                    Equipment registration
                </p>

            </div>

            <div id="chessContent"></div>

        </section>



        <!-- HACKATHON -->

        <section
            id="hackathon"
            class="page"
        >

            <div class="page-header">

                <span>ACTIVITY 05</span>

                <h2>HACKATHON</h2>

                <p>
                    Equipment registration
                </p>

            </div>

            <div id="hackathonContent"></div>

        </section>

    </main>

</div>


<div
    id="notification"
    class="notification"
></div>

</div>
<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="delete-modal">
    <div class="delete-modal-box">
        <h3>Delete Registration</h3>

        <p>Are you sure you want to delete this registration?</p>

        <div class="delete-modal-buttons">
            <button id="cancelDelete" type="button">
                CANCEL
            </button>

            <button id="confirmDelete" type="button">
                DELETE
            </button>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="script.js"></script>

</body>
</html>